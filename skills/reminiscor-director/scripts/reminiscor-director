#!/usr/bin/env bash
# Runs the reminiscor-director program, installing it first when needed:
#
#   scripts/reminiscor-director <command> [args...]   run a program command
#   scripts/reminiscor-director update --check        the installed and latest versions, and what is new
#   scripts/reminiscor-director update                install the latest release, if newer
#
# Mac (Apple Silicon), Linux x64, and Windows x64 under Git Bash (the shell
# Claude Code runs there); where Windows has no bash, reminiscor-director.cmd
# next to this runs reminiscor-director.ps1, which does the same.
#
# The program comes from this repo's Releases (plain HTTPS, checked against
# SHA256SUMS) into its own folder. VERSION below is the lowest version this
# plugin works with: an older or missing program is replaced by it on the next
# call. `update` moves up to the latest release. Both read this repo's
# CHANGELOG.md, which the release workflow writes after each release: its
# first version is the latest.
#
# Every install stops what the old program runs, runs `setup` (which installs
# only what changed, such as a new ComfyUI commit) and starts it again. The
# data folder (records, database, media, ComfyUI's models) is the program's
# own, elsewhere, and is never touched here.
#
# Overrides: REMINISCOR_DIRECTOR_PROGRAM (program folder),
# REMINISCOR_DIRECTOR_HOME (data folder, read by the program itself),
# REMINISCOR_DIRECTOR_RELEASES and REMINISCOR_DIRECTOR_CHANGELOG (for testing a build).
set -euo pipefail

VERSION=0.1.3
REPO=reminiscor-vr/skills

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
log() { printf '==> %s\n' "$*" >&2; }

case "$(uname -s)-$(uname -m)" in
    Darwin-arm64)
        system=macos-arm64
        base="$HOME/Library/Application Support/reminiscor-director-program" ;;
    Linux-x86_64)
        system=linux-x64
        base="${XDG_DATA_HOME:-$HOME/.local/share}/reminiscor-director-program" ;;
    MINGW*-x86_64 | MSYS*-x86_64 | CYGWIN*-x86_64)
        system=windows-x64
        base="$(cygpath -u "${LOCALAPPDATA:-$USERPROFILE/AppData/Local}")/reminiscor-director-program" ;;
    *) die "unsupported system: $(uname -s)-$(uname -m) (Mac Apple Silicon, Linux x64 or Windows x64)" ;;
esac
ext=tar.gz exe=reminiscor-director
[ "$system" = windows-x64 ] && ext=zip exe=reminiscor-director.exe
base="${REMINISCOR_DIRECTOR_PROGRAM:-$base}"
releases="${REMINISCOR_DIRECTOR_RELEASES:-https://github.com/$REPO/releases/download}"
changelog_url="${REMINISCOR_DIRECTOR_CHANGELOG:-https://raw.githubusercontent.com/$REPO/main/CHANGELOG.md}"

exe_of() { printf '%s/%s/reminiscor-director/%s' "$base" "$1" "$exe"; }

# The installed version, when its program is there.
installed() {
    local v
    v=$(cat "$base/current" 2>/dev/null) || return 0
    [ -x "$(exe_of "$v")" ] && printf '%s' "$v"
}

# Whether version $1 is older than $2.
older() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -1)" = "$1" ]; }

sha256() {
    if command -v shasum >/dev/null; then shasum -a 256 "$1"; else sha256sum "$1"; fi | awk '{print $1}'
}

# Unpack archive $1 into folder $2. Git Bash's tar cannot read a zip; Windows'
# own tar (bsdtar) can, and unzip, when Git ships it, too.
unpack() {
    case "$1" in
        *.zip)
            if command -v unzip >/dev/null; then
                unzip -q "$1" -d "$2"
            else
                "$(cygpath -u "${SYSTEMROOT:-C:/Windows}")/System32/tar.exe" -xf "$(cygpath -w "$1")" -C "$(cygpath -w "$2")"
            fi ;;
        *) tar -xzf "$1" -C "$2" ;;
    esac || die "could not unpack $1"
}

# Download, check and unpack version $1 into its own folder.
fetch() {
    local version=$1 archive="reminiscor-director-$1-$system.$ext" url="$releases/v$1" tmp want
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"; trap - RETURN' RETURN
    log "downloading reminiscor-director $version ($system)"
    curl -fsSL "$url/$archive" -o "$tmp/$archive" || die "could not download $url/$archive"
    curl -fsSL "$url/SHA256SUMS" -o "$tmp/SHA256SUMS" || die "could not download $url/SHA256SUMS"
    want=$(awk -v f="$archive" '$2 == f || $2 == "*"f {print $1}' "$tmp/SHA256SUMS")
    [ -n "$want" ] || die "$archive is not listed in SHA256SUMS"
    [ "$(sha256 "$tmp/$archive")" = "$want" ] || die "$archive does not match SHA256SUMS; not installed"
    mkdir -p "$tmp/unpacked"
    unpack "$tmp/$archive" "$tmp/unpacked"
    [ -x "$tmp/unpacked/reminiscor-director/$exe" ] || die "$archive has no reminiscor-director program"
    mkdir -p "$base"
    rm -rf "${base:?}/$version"
    mv "$tmp/unpacked" "$base/$version"
}

# Install version $1 in place of the current one, keeping what runs running.
install() {
    local version=$1 old running="" new status
    old=$(installed)
    fetch "$version"
    # Captured first: grep -q quits at the first match, and under pipefail
    # the writer's SIGPIPE would make the pipe fail.
    [ -n "$old" ] && status=$("$(exe_of "$old")" status 2>/dev/null) || status=""
    if printf '%s\n' "$status" | grep -qE '^(ComfyUI|app) +up'; then
        running=1
        log "stopping reminiscor-director $old"
        "$(exe_of "$old")" stop >&2 || true
    fi
    printf '%s\n' "$version" > "$base/current"
    # Older programs; the data folder is elsewhere and stays.
    find "$base" -mindepth 1 -maxdepth 1 -type d ! -name "$version" -exec rm -rf {} +
    log "installed reminiscor-director $version${old:+ (was $old)}"
    new=$(exe_of "$version")
    "$new" setup >&2 || die "setup failed; run it again: $0 setup"
    if [ -n "$running" ]; then
        "$new" start >&2 || die "could not start it again: $0 start"
    fi
}

# The first version in a changelog read from stdin.
latest() { sed -n 's/^## \([0-9][0-9.]*\)\( .*\)\{0,1\}$/\1/p' | head -1; }

# The sections of a changelog (stdin) for versions newer than $1.
newer_than() {
    local since=$1 line v show=""
    while IFS= read -r line; do
        case "$line" in
            "## "[0-9]*)
                v=${line#"## "}; v=${v%% *}
                show=""; { [ -z "$since" ] || older "$since" "$v"; } && show=1 ;;
            "## "*) show="" ;;
        esac
        [ -n "$show" ] && printf '%s\n' "$line"
    done
    return 0
}

current=$(installed)

if [ "${1:-}" = update ]; then
    changes=$(curl -fsSL "$changelog_url") || die "could not read $changelog_url; check the network"
    newest=$(printf '%s\n' "$changes" | latest)
    [ -n "$newest" ] || die "no version in $changelog_url"
    if [ -n "$current" ] && ! older "$current" "$newest"; then
        echo "reminiscor-director $current is the latest"
        exit 0
    fi
    if [ "${2:-}" = --check ]; then
        echo "installed: ${current:-none}"
        echo "latest: $newest"
        echo
        printf '%s\n' "$changes" | newer_than "$current"
        exit 0
    fi
    install "$newest"
    echo "reminiscor-director updated to $newest${current:+ from $current}"
    exit 0
fi

if [ -z "$current" ] || older "$current" "$VERSION"; then
    install "$VERSION"
    current=$VERSION
fi
exec "$(exe_of "$current")" "$@"
